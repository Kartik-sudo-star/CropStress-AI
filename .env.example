# ============================================================
# ENVIRONMENT VARIABLES - Deepfake Detection System
# "AI-Driven Detection and Mitigation of Deepfake-Driven
#  Cyber Crimes on Social Media: A Study with Reference to India"
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ------------------------------------------------------------
# GENERAL
# ------------------------------------------------------------
PROJECT_NAME=DeepfakeCyberCrimeDetection
VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------
# DEVICE & HARDWARE
# ------------------------------------------------------------
DEVICE=cpu  # cpu or cuda
CUDA_VISIBLE_DEVICES=0
MIXED_PRECISION=false

# ------------------------------------------------------------
# PATHS (relative to project root)
# ------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_TRAIN_DIR=data/train
DATA_VAL_DIR=data/validation
DATA_TEST_DIR=data/test
MODELS_DIR=models
LOGS_DIR=logs
CHECKPOINTS_DIR=models/checkpoints
REPORTS_DIR=reports
TEMP_DIR=temp

# ------------------------------------------------------------
# DATABASE (SQLite)
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./deepfake_analysis.db
DATABASE_ECHO=false

# ------------------------------------------------------------
# BACKEND API
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# MODEL PATHS (populated after training)
# ------------------------------------------------------------
IMAGE_DETECTOR_PATH=models/image_detector/best_model.pth
IMAGE_PREPROCESSOR_PATH=models/image_detector/preprocessor.pkl
VIDEO_DETECTOR_PATH=models/video_detector/best_model.pth
VIDEO_PREPROCESSOR_PATH=models/video_detector/preprocessor.pkl
AUDIO_DETECTOR_PATH=models/audio_detector/best_model.pth
AUDIO_PREPROCESSOR_PATH=models/audio_detector/preprocessor.pkl
MULTIMODAL_DETECTOR_PATH=models/multimodal_detector/best_model.pth

# ------------------------------------------------------------
# PREDICTION SETTINGS
# ------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_AUDIO_SIZE_MB=20
ENABLE_EXPLAINABILITY=true
ENABLE_FORENSIC=true
ENABLE_RISK_ASSESSMENT=true

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# TRAINING (can be overridden by config.yaml)
# ------------------------------------------------------------
RANDOM_SEED=42
NUM_WORKERS=4
BATCH_SIZE=16
IMAGE_MODEL_EPOCHS=30
VIDEO_MODEL_EPOCHS=25
AUDIO_MODEL_EPOCHS=50
LEARNING_RATE=0.001

# ------------------------------------------------------------
# SECURITY (for production)
# ------------------------------------------------------------
# SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# API_KEY_ENABLED=false
# API_KEY=your-api-key
